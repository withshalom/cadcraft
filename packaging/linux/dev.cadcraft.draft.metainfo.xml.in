<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>dev.cadcraft.draft</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>DraftCraft</name>
  <summary>Draft, dimension and plot 2D drawings that keep your DWG files whole</summary>
  <developer id="com.withshalom">
    <name>WithShalom Studios</name>
  </developer>
  <description>
    <p>
      DraftCraft is an open-source computer-aided design and drafting application with a familiar
      command line, object snaps, layers, dimensions, hatches and blocks. It opens and saves DXF
      and DWG drawings, exports SVG and PNG, and can be driven by AI agents over MCP. It is
      WithShalom Studios' build of CADCraft by the ArtCraft team.
    </p>
  </description>
  <launchable type="desktop-id">dev.cadcraft.draft.desktop</launchable>
  <icon type="stock">dev.cadcraft.draft</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://draftcraft.dev</url>
  <url type="bugtracker">https://github.com/withshalom/draftcraft/issues</url>
  <url type="help">https://github.com/withshalom/draftcraft</url>
  <url type="contact">https://github.com/withshalom/draftcraft</url>
  <categories>
    <category>Graphics</category>
    <category>Engineering</category>
  </categories>
  <keywords>
    <keyword>CAD</keyword>
    <keyword>drafting</keyword>
    <keyword>DXF</keyword>
    <keyword>DWG</keyword>
  </keywords>
  <screenshots>
    <screenshot type="default">
      <caption>A mechanical part drawing with dimensions, hatching and layers</caption>
      <image>https://raw.githubusercontent.com/withshalom/draftcraft/dwg-web/docs/images/ui-bracket.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#9cc3ff</color>
    <color type="primary" scheme_preference="dark">#0e3463</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>draftcraft</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
